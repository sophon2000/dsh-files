{
  "name": "dsh-files",
  "version": "0.5.3-vh.2",
  "description": "Video Harness read_document plugin for bounded, cancellable text/PDF/DOC/DOCX/XLSX extraction; native DSH owns attachments and file UI.",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "cordis",
    "plugin",
    "pdf",
    "docx",
    "xlsx",
    "doc"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "CHANGELOG.md",
    "README.md",
    "README.zh.md",
    "FORK.md"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "mammoth": "1.12.2",
    "pdfjs-dist": "4.10.38",
    "read-excel-file": "5.8.8",
    "word-extractor": "1.0.4",
    "yauzl": "3.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2.vh.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.2.0",
    "@types/yauzl": "2.10.3",
    "esbuild": "^0.24.2",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.7.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node build.mjs",
    "test": "pnpm run typecheck && node --test",
    "check": "pnpm run build && pnpm test",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "packageManager": "pnpm@11.9.0"
}
